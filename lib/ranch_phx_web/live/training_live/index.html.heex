<.styles />
<.app_nav active={:training} />

<div class="tr-wrap">
  <div :if={@cards == [] and not @show_new} class="tr-card">
    <h2>No horses in training yet</h2>
    <p class="tr-muted" style="margin-top:6px">
      Start a book for a horse to get a plan by age and a quick session log.
    </p>
  </div>

  <a
    :for={c <- @cards}
    class="tr-card tr-horse"
    href={~p"/training/#{c.book.id}"}
    id={"book-#{c.book.id}"}
  >
    <div class="tr-horse-head">
      <.horse_photo horse={c.book.horse} size={64} />
      <div style="flex:1;min-width:0">
        <h2>{c.book.horse.name}</h2>
        <p class="tr-muted">
          {Training.age_label(c.progress.age_months)}<span :if={c.progress.stage}> · Stage {c.progress.stage_number} of {c.progress.stage_count}</span>
        </p>
        <p :if={c.progress.stage} class="tr-hc-stage">{c.progress.stage.name}</p>
        <p :if={c.book.horse.owner && is_nil(c.book.horse.animal_id)} class="tr-muted">
          Owner: {c.book.horse.owner}
        </p>
      </div>
    </div>

    <div class="tr-hc-last">
      <div class="tr-label">Last session</div>
      <%= if c.last do %>
        <b>
          {when_label(c.last.date, @today)}<span :if={c.last.minutes}> · {c.last.minutes} min</span>
        </b>
        <p>
          <span :for={{a, i} <- Enum.with_index(c.last.activities, 1)}>
            {a.activity.name}<span :if={a.result} class={"tr-res res-#{a.result}"}> ({a.result})</span>{comma(
              i,
              c.last.activities
            )}
          </span>
        </p>
      <% else %>
        <p>Nothing logged yet.</p>
      <% end %>
    </div>

    <div class="tr-hc-sum">
      <div class="tr-hc-box">
        <div class="tr-label">Last 7 days</div>
        <% max = c.progress.stage && c.progress.stage.max_sessions_per_week %>
        <div class={["tr-hc-big", max && c.week.sessions > max && "tr-hc-over"]}>
          {c.week.sessions}<small :if={max}> of {max}</small>
        </div>
        <div class="tr-hc-sub">
          {if c.week.sessions == 1, do: "session", else: "sessions"} · {c.week.minutes} min total
        </div>
      </div>
      <div class="tr-hc-box">
        <div class="tr-label">Next goal</div>
        <%= if c.progress.next_goal do %>
          <div class="tr-hc-goal">{c.progress.next_goal.title}</div>
          <div class="tr-hc-sub">
            {countdown(c.progress.days_to_goal)} · {Calendar.strftime(
              c.progress.next_goal.target_date,
              "%b %-d, %Y"
            )}
          </div>
        <% else %>
          <div class="tr-hc-sub">No dated goal yet</div>
        <% end %>
      </div>
    </div>
  </a>

  <%= if @is_superuser do %>
    <button :if={not @show_new} class="tr-btn tr-btn-block" phx-click="open_new">
      + Start a training book
    </button>

    <div :if={@show_new} class="tr-card" id="new-book">
      <div class="tr-row" style="margin-bottom:14px">
        <h2>Start a training book</h2>
        <button class="tr-link-btn" phx-click="close_new">Cancel</button>
      </div>

      <div class="tr-segment" style="margin-bottom:16px">
        <button
          type="button"
          class={if @source == "ranch", do: "on"}
          phx-click="set_source"
          phx-value-source="ranch"
        >
          Ranch horse
        </button>
        <button
          type="button"
          class={if @source == "other", do: "on"}
          phx-click="set_source"
          phx-value-source="other"
        >
          Another horse
        </button>
      </div>

      <.form for={%{}} id="new-book-form" phx-change="validate" phx-submit="create_book">
        <%= if @source == "ranch" do %>
          <%= if @ranch_horses == [] do %>
            <p class="tr-muted" style="margin-bottom:16px">
              Every active ranch horse already has a book. Use “Another horse” for a horse
              that isn't on the ranch.
            </p>
          <% else %>
            <div class="tr-field">
              <label for="book_animal_id">Horse</label>
              <select id="book_animal_id" name="book[animal_id]" required>
                <option value="">Pick a horse…</option>
                <option
                  :for={h <- @ranch_horses}
                  value={h.id}
                  selected={"#{h.id}" == "#{@selected_animal_id}"}
                >
                  {h.name}{if h.birth_date,
                    do: " (#{Training.age_label(Training.age_in_months(h.birth_date, @today))})"}
                </option>
              </select>
            </div>
          <% end %>
        <% else %>
          <div class="tr-field">
            <label for="horse_name">Name</label>
            <input
              type="text"
              id="horse_name"
              name="horse[name]"
              value={@horse_form[:name].value}
              autocomplete="off"
              required
            />
            <span :for={{msg, _} <- @horse_form[:name].errors} class="tr-error">{msg}</span>
          </div>
          <div class="tr-field">
            <label for="horse_foaled_on">Foaling date</label>
            <input
              type="date"
              id="horse_foaled_on"
              name="horse[foaled_on]"
              value={@horse_form[:foaled_on].value}
            />
            <span class="tr-muted" style="font-size:14px">
              The stage follows his age. If you only know the year, use Jan 1.
            </span>
          </div>
          <div class="tr-field">
            <label for="horse_sex">Sex</label>
            <select id="horse_sex" name="horse[sex]">
              <option value="">–</option>
              <option value="stallion">Stud / colt</option>
              <option value="gelding">Gelding</option>
              <option value="mare">Mare / filly</option>
            </select>
          </div>
          <div class="tr-field">
            <label for="horse_owner">Owner</label>
            <input
              type="text"
              id="horse_owner"
              name="horse[owner]"
              value={@horse_form[:owner].value}
            />
          </div>
          <div class="tr-two">
            <div class="tr-field">
              <label for="horse_breed">Breed</label>
              <input
                type="text"
                id="horse_breed"
                name="horse[breed]"
                value={@horse_form[:breed].value}
              />
            </div>
            <div class="tr-field">
              <label for="horse_color">Color</label>
              <input
                type="text"
                id="horse_color"
                name="horse[color]"
                value={@horse_form[:color].value}
              />
            </div>
          </div>
          <div class="tr-field">
            <span class="tr-label">Photo</span>
            <.photo_picker upload={@uploads.photo} />
          </div>
        <% end %>

        <div class="tr-field">
          <label for="book_program_id">Program</label>
          <select id="book_program_id" name="book[program_id]" required>
            <option
              :for={p <- @programs}
              value={p.id}
              selected={"#{p.id}" == "#{@book_form[:program_id].value}"}
            >
              {p.name}
            </option>
          </select>
        </div>
        <div class="tr-field">
          <label for="book_goal">Goal (optional)</label>
          <input
            type="text"
            id="book_goal"
            name="book[goal]"
            value={@book_form[:goal].value}
            placeholder="e.g. NRCHA Stallion Stakes, non-pro"
          />
        </div>
        <div class="tr-field">
          <label for="book_goal_date">Goal date (optional)</label>
          <input
            type="date"
            id="book_goal_date"
            name="book[goal_date]"
            value={@book_form[:goal_date].value}
          />
        </div>
        <span :for={{msg, _} <- @book_form[:horse_id].errors} class="tr-error">
          This horse {msg}.
        </span>
        <input type="hidden" name="book[started_on]" value={@book_form[:started_on].value} />
        <button
          type="submit"
          class="tr-btn tr-btn-primary tr-btn-block"
          phx-disable-with="Starting…"
        >
          Start book
        </button>
      </.form>
    </div>
  <% end %>
</div>
