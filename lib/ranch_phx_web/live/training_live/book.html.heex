<.styles />
<.app_nav active={:training} detail />
<.topbar back={~p"/training"} back_label="Training" title={@book.horse.name} />

<div class="tr-wrap tr-folds" id="book-sections" phx-hook="Sections">
  <div
    :if={Phoenix.Flash.get(@flash, :info)}
    class="tr-guard"
    style="font-weight:600"
    phx-click="lv:clear-flash"
    phx-value-key="info"
  >
    {Phoenix.Flash.get(@flash, :info)}
  </div>

  <.section_nav items={
    [
      {"today", "Today", "hero-sun", "today"},
      {"goals", "Goals", "hero-flag", "goals"},
      {"working-on", "Working on", "hero-wrench-screwdriver", "working"},
      {"now", "Stage", "hero-map", "stage"},
      {"timeline", "Timeline", "hero-chart-bar", "timeline"}
    ] ++
      if(@is_superuser,
        do: [
          {"coach", "TrAIner", "hero-sparkles", "trainer"},
          {"log", "Log", "hero-pencil-square", "log"}
        ],
        else: []
      ) ++ [{"sessions", "Sessions", "hero-calendar-days", "sessions"}]
  } />

  <%!-- Today --%>
  <div class="tr-card tr-sec sec-today" id="today">
    <.section_head icon="hero-sun" kind="today">
      Today
      <:actions>
        <span class={["tr-day-status", "st-#{@plan.status}"]}>
          {case @plan.status do
            :done -> "✓ Done"
            :rest -> "Rest day"
            :work -> "Work day"
          end}
        </span>
      </:actions>
    </.section_head>

    <div class="tr-strip" aria-label="Last 7 days">
      <div
        :for={d <- @plan.days}
        class={["tr-strip-day", d.worked? && "worked", d.date == @today && "today"]}
        title={"#{Calendar.strftime(d.date, "%a %b %-d")}: #{if d.worked?, do: "#{d.minutes} min", else: "rest"}"}
      >
        <small>{if d.date == @today, do: "Today", else: Calendar.strftime(d.date, "%a")}</small>
        <span>
          {if d.worked?, do: if(d.minutes > 0, do: "#{d.minutes}m", else: "✓"), else: "–"}
        </span>
      </div>
    </div>

    <p class="tr-today-reason">{@plan.reason}</p>

    <div :if={@plan.status == :work} class="tr-today-plan" id="today-plan">
      <div :if={@plan.focus != []}>
        <div class="tr-label">Focus on</div>
        <div :for={i <- @plan.focus} class="tr-today-focus">
          <b>{i.title}</b>
          <span :if={i.marks != []} class={"tr-res mk-#{List.first(i.marks).progress}"}>
            last time {progress_icon(List.first(i.marks).progress)} {List.first(i.marks).progress}
          </span>
        </div>
      </div>
      <div :if={@plan.activities != []} style="margin-top:8px">
        <div class="tr-label">Suggested</div>
        <p>
          {Enum.map_join(@plan.activities, ", ", & &1.name)} · about {@plan.minutes} min
        </p>
      </div>
      <a
        :if={@is_superuser and @plan.activities != []}
        href="#log"
        class="tr-btn tr-btn-primary tr-btn-block"
        style="margin-top:12px;text-decoration:none"
        id="plan-fill"
        phx-click="plan_fill"
      >
        Log this session
      </a>
    </div>
  </div>

  <%!-- The horse --%>
  <div class="tr-card" id="profile">
    <%= if @profile_form do %>
      <div class="tr-row" style="margin-bottom:14px">
        <h2>Edit profile</h2>
        <button class="tr-link-btn" phx-click="cancel_profile">Cancel</button>
      </div>
      <.form
        for={@profile_form}
        as={:horse}
        id="profile-form"
        phx-change="validate_profile"
        phx-submit="save_profile"
      >
        <div class="tr-field">
          <label for="horse_name">Name</label>
          <input
            type="text"
            id="horse_name"
            name="horse[name]"
            value={@profile_form[:name].value}
            required
          />
          <span :for={{msg, _} <- @profile_form[:name].errors} class="tr-error">{msg}</span>
        </div>
        <div class="tr-field">
          <label for="horse_foaled_on">Foaling date</label>
          <input
            type="date"
            id="horse_foaled_on"
            name="horse[foaled_on]"
            value={@profile_form[:foaled_on].value}
          />
        </div>
        <div class="tr-field">
          <label for="horse_sex">Sex</label>
          <select id="horse_sex" name="horse[sex]">
            <option value="">–</option>
            <option
              :for={
                {v, l} <- [
                  {"stallion", "Stud / colt"},
                  {"gelding", "Gelding"},
                  {"mare", "Mare / filly"}
                ]
              }
              value={v}
              selected={@profile_form[:sex].value == v}
            >
              {l}
            </option>
          </select>
        </div>
        <div class="tr-field">
          <label for="horse_owner">Owner</label>
          <input
            type="text"
            id="horse_owner"
            name="horse[owner]"
            value={@profile_form[:owner].value}
          />
        </div>
        <div class="tr-two">
          <div class="tr-field">
            <label for="horse_breed">Breed</label>
            <input
              type="text"
              id="horse_breed"
              name="horse[breed]"
              value={@profile_form[:breed].value}
            />
          </div>
          <div class="tr-field">
            <label for="horse_color">Color</label>
            <input
              type="text"
              id="horse_color"
              name="horse[color]"
              value={@profile_form[:color].value}
            />
          </div>
        </div>
        <div class="tr-field">
          <label for="horse_notes">Notes</label>
          <textarea
            id="horse_notes"
            name="horse[notes]"
            placeholder="Background, quirks, what the owner wants…"
          >{@profile_form[:notes].value}</textarea>
        </div>
        <div class="tr-field">
          <span class="tr-label">Photo</span>
          <.photo_picker
            upload={@uploads.photo}
            label={if @book.horse.photo_url, do: "Change photo", else: "Take or choose a photo"}
          />
        </div>
        <button
          type="submit"
          class="tr-btn tr-btn-primary tr-btn-block"
          phx-disable-with="Saving…"
        >
          Save profile
        </button>
      </.form>
    <% else %>
      <div class="tr-horse-head">
        <.horse_photo horse={@book.horse} size={88} />
        <div style="flex:1;min-width:0">
          <h2>{@book.horse.name}</h2>
          <p class="tr-muted">
            {[
              Training.age_label(@progress.age_months),
              sex_label(@book.horse.sex),
              @book.horse.color,
              @book.horse.breed
            ]
            |> Enum.reject(&(&1 in [nil, ""]))
            |> Enum.join(" · ")}
          </p>
          <p :if={@book.horse.owner} class="tr-muted">Owner: {@book.horse.owner}</p>
          <a
            :if={@book.horse.animal_id}
            href={~p"/animals/#{@book.horse.animal_id}"}
            class="tr-muted"
            style="color:var(--brand)"
          >
            Ranch record →
          </a>
        </div>
      </div>
      <p
        :if={@book.horse.notes && @book.horse.notes != ""}
        style="margin-top:10px;white-space:pre-line"
      >
        {@book.horse.notes}
      </p>
      <button
        :if={@is_superuser}
        class="tr-mini"
        style="margin-top:12px"
        phx-click="edit_profile"
      >
        Edit profile
      </button>
    <% end %>
  </div>

  <%!-- Goals --%>
  <div class="tr-card tr-sec sec-goals" id="goals" data-force-open={@editing_goal && "1"}>
    <.section_head icon="hero-flag" kind="goals">
      Goals
      <:actions>
        <button
          :if={@is_superuser and is_nil(@editing_goal)}
          class="tr-mini"
          phx-click="new_goal"
        >
          + Add goal
        </button>
      </:actions>
    </.section_head>

    <.goal_form :if={@editing_goal == :new} form={@goal_form} new />

    <% active = Enum.filter(@book.goals, &(&1.status == "active")) %>
    <% finished = Enum.reject(@book.goals, &(&1.status == "active")) %>
    <p :if={active == [] and @editing_goal != :new} class="tr-muted">
      No goals yet. Add what you're working toward: a show, a skill, a date.
    </p>

    <div :for={g <- active} class="tr-item" id={"goal-#{g.id}"}>
      <%= if @editing_goal == g.id do %>
        <.goal_form form={@goal_form} goal_id={g.id} />
      <% else %>
        <div class="tr-item-top">
          <div class="tr-item-title">{g.title}</div>
          <span :if={g.target_date} class="tr-count">{goal_countdown(g, @today)}</span>
        </div>
        <div :if={g.target_date} class="tr-item-meta">
          <span>
            <.icon name="hero-calendar" />{Calendar.strftime(g.target_date, "%b %-d, %Y")}
          </span>
        </div>
        <p :if={g.notes && g.notes != ""} class="tr-item-note">{g.notes}</p>
        <div :if={@is_superuser} class="tr-item-actions">
          <button
            class="tr-mini"
            phx-click="goal_status"
            phx-value-id={g.id}
            phx-value-status="done"
          >
            ✓ Done
          </button>
          <button
            class="tr-mini tr-icon-only"
            phx-click="edit_goal"
            phx-value-id={g.id}
            aria-label="Edit goal"
          >
            <.icon name="hero-pencil" />
          </button>
        </div>
      <% end %>
    </div>

    <button
      :if={finished != []}
      class="tr-link-btn"
      style="padding:0;margin-top:8px"
      phx-click="toggle_done_goals"
    >
      {if @show_done_goals, do: "Hide", else: "Show"} finished goals ({length(finished)})
    </button>
    <div :for={g <- finished} :if={@show_done_goals} class="tr-item" style="opacity:.75">
      <div class="tr-item-title">{g.title}</div>
      <div class="tr-item-meta">
        {if g.status == "done",
          do: "Done#{if g.done_on, do: " " <> Calendar.strftime(g.done_on, "%b %-d, %Y")}",
          else: "Dropped"}
        <button
          :if={@is_superuser}
          class="tr-link-btn"
          style="padding:0"
          phx-click="goal_status"
          phx-value-id={g.id}
          phx-value-status="active"
        >
          Reopen
        </button>
      </div>
    </div>
  </div>

  <%!-- Working on --%>
  <div class="tr-card tr-sec sec-working" id="working-on" data-force-open={@editing_issue && "1"}>
    <.section_head icon="hero-wrench-screwdriver" kind="working">
      Working on
      <:actions>
        <button
          :if={@is_superuser and is_nil(@editing_issue)}
          class="tr-mini"
          phx-click="new_issue"
        >
          + Add
        </button>
      </:actions>
    </.section_head>

    <.issue_form :if={@editing_issue == :new} form={@issue_form} activities={@activities} />

    <% open = Enum.reject(@issues, &(&1.status == "solved")) %>
    <% solved = Enum.filter(@issues, &(&1.status == "solved")) %>
    <p :if={open == [] and @editing_issue != :new} class="tr-muted">
      Nothing yet. Add a problem you're working through, like “Picking up left hind”. Each
      session can mark it better, same or worse.
    </p>

    <div
      :for={i <- open ++ if(@show_solved, do: solved, else: [])}
      class="tr-item"
      id={"issue-#{i.id}"}
    >
      <%= if @editing_issue == i.id do %>
        <.issue_form form={@issue_form} activities={@activities} issue_id={i.id} />
      <% else %>
        <div class="tr-item-top">
          <div class="tr-item-title">{i.title}</div>
          <span style="display:inline-flex;align-items:center;gap:6px;flex:none">
            <span class={"tr-status st-#{i.status}"}>{String.capitalize(i.status)}</span>
            <button
              :if={@is_superuser}
              class="tr-mini tr-icon-only"
              phx-click="edit_issue"
              phx-value-id={i.id}
              aria-label="Edit"
            >
              <.icon name="hero-pencil" />
            </button>
          </span>
        </div>
        <div class="tr-item-meta">
          <span :if={issue_meta(i) != ""}>{issue_meta(i)}</span>
          <span>
            Since {Calendar.strftime(i.opened_on, "%b %-d")}<span :if={i.solved_on}>, solved {Calendar.strftime(i.solved_on, "%b %-d")}</span>
          </span>
        </div>
        <div :if={i.marks != []} class="tr-trend" aria-label="Last sessions, newest first">
          <span
            :for={m <- Enum.take(i.marks, 8)}
            class={"tr-mark mk-#{m.progress}"}
            title={"#{fmt_date(m.session.date, @today)}: #{m.progress}"}
          >
            {progress_icon(m.progress)}
          </span>
        </div>
        <p :if={i.notes && i.notes != ""} class="tr-item-note">{i.notes}</p>

        <div :if={@issue_history == i.id} class="tr-history">
          <div :for={m <- i.marks} class="tr-muted" style="font-size:15px">
            <b class={"tr-res mk-#{m.progress}"}>
              {progress_icon(m.progress)} {String.capitalize(m.progress)}
            </b>
            · {fmt_date(m.session.date, @today)}<span :if={m.note}> · {m.note}</span>
          </div>
        </div>

        <div class="tr-item-actions">
          <button
            :if={i.marks != []}
            class="tr-mini"
            phx-click="toggle_issue_history"
            phx-value-id={i.id}
          >
            {if @issue_history == i.id, do: "Hide history", else: "History (#{length(i.marks)})"}
          </button>
          <%= if @is_superuser do %>
            <button
              :for={{v, l} <- issue_statuses()}
              :if={v != i.status}
              class="tr-mini"
              phx-click="issue_status"
              phx-value-id={i.id}
              phx-value-status={v}
            >
              {if v == "solved", do: "✓ Solved", else: l}
            </button>
          <% end %>
        </div>
      <% end %>
    </div>

    <button
      :if={solved != []}
      class="tr-link-btn"
      style="padding:0;margin-top:8px"
      phx-click="toggle_solved"
    >
      {if @show_solved, do: "Hide", else: "Show"} solved ({length(solved)})
    </button>
  </div>

  <%!-- Where he is now, and what's next --%>
  <div class="tr-card tr-sec sec-stage" id="now">
    <.section_head icon="hero-map" kind="stage">
      Stage
      <:actions>
        <span class="tr-count">
          {Training.age_label(@progress.age_months)}<span :if={@progress.stage}> · {@progress.stage_number} of {@progress.stage_count}</span>
        </span>
      </:actions>
    </.section_head>
    <%= if @progress.stage do %>
      <div class="tr-item-title" style="font-size:19px">{@progress.stage.name}</div>
      <p class="tr-muted" style="margin-top:4px">{@progress.stage.summary}</p>
      <ul class="tr-list">
        <li :for={f <- @progress.stage.focus}>{f}</li>
      </ul>
      <div class="tr-guard">
        <b>Keep it light:</b> {@progress.stage.guardrail}
        <span :if={@progress.stage.max_session_minutes}>
          Up to {@progress.stage.max_session_minutes} min a session<span :if={
            @progress.stage.max_sessions_per_week
          }>, {@progress.stage.max_sessions_per_week} sessions a week</span>.
        </span>
      </div>
      <p
        :if={
          (@progress.overridden? and @progress.by_age) &&
            @progress.by_age.id != @progress.stage.id
        }
        class="tr-muted"
        style="margin-top:10px"
      >
        Set by hand. By age he'd be in “{@progress.by_age.name}”.
      </p>
    <% end %>
    <p :if={is_nil(@book.horse.foaled_on)} class="tr-warn" style="margin-top:12px">
      No foaling date yet, so the stage can't follow his age. Add it with Edit profile.
    </p>

    <div class="tr-stats">
      <div class="tr-stat"><b>{@week.sessions}</b><span>sessions, 7 days</span></div>
      <div class="tr-stat"><b>{@week.minutes}</b><span>minutes, 7 days</span></div>
      <div class="tr-stat">
        <b>{if @progress.days_to_goal, do: @progress.days_to_goal, else: "–"}</b>
        <span>days to goal</span>
      </div>
    </div>
    <p :if={@progress.next_goal} class="tr-muted" style="margin-top:10px">
      Next goal: {@progress.next_goal.title}
    </p>

    <div :if={@progress.next} class="tr-next">
      <div class="tr-label">Next stage</div>
      <b>{@progress.next.name}</b>
      <p class="tr-muted">
        <%= cond do %>
          <% @progress.months_to_next == nil -> %>
            From {@progress.next.from_age_months} months.
          <% @progress.months_to_next == 0 -> %>
            He's old enough now. Move on when he's ready.
          <% true -> %>
            From {@progress.next.from_age_months} months, about {@progress.months_to_next} {if @progress.months_to_next ==
                                                                                                 1,
                                                                                               do:
                                                                                                 "month",
                                                                                               else:
                                                                                                 "months"} away.
        <% end %>
      </p>
      <div :if={@is_superuser} class="tr-item-actions">
        <button class="tr-mini" phx-click="set_stage" phx-value-id={@progress.next.id}>
          Ready: move to this stage
        </button>
        <button :if={@progress.overridden?} class="tr-mini" phx-click="set_stage">
          Follow his age again
        </button>
      </div>
    </div>
    <div
      :if={is_nil(@progress.next) and @progress.overridden? and @is_superuser}
      class="tr-item-actions"
    >
      <button class="tr-mini" phx-click="set_stage">Follow his age again</button>
    </div>
  </div>

  <%!-- The program on the calendar, and what's been logged --%>
  <.timeline_card
    tl={@timeline}
    today={@today}
    show_weeks={@show_weeks}
    selected_id={@tl_stage_id}
  />

  <%!-- Ask the TrAIner --%>
  <div :if={@is_superuser} class="tr-card tr-sec sec-trainer" id="coach" data-force-open={(@coach_loading || @coach_error) && "1"}>
    <.section_head icon="hero-sparkles" kind="trainer">
      Ask the Tr<span class="tr-ai">AI</span>ner
      <:actions>
        <button
          :if={@coach_on and @coach_thread != [] and is_nil(@coach_loading)}
          id="coach-new"
          class="tr-mini"
          phx-click="coach_new"
        >
          + New
        </button>
      </:actions>
    </.section_head>
    <%= if @coach_on do %>
      <p :if={@coach_thread == [] and is_nil(@coach_loading)} class="tr-muted">
        Ask how he's doing, what to work on, or how to get through something that's giving you
        trouble. It checks {@book.horse.name}'s log before it answers.
      </p>

      <% cards = length(@coach_thread) + if(@coach_loading, do: 1, else: 0) %>
      <div :if={cards > 0} class="tr-deck" id="coach-deck" phx-hook="CoachDeck">
        <div class="tr-deck-track">
          <article :for={m <- @coach_thread} class="tr-qa" id={"coach-#{m.id}"}>
            <div class="tr-qa-q">
              <span class="tr-qa-label">You asked</span>
              <p>{m.question}</p>
            </div>
            <div class="tr-qa-a">
              <.coach_answer text={m.answer} />
            </div>
            <div class="tr-qa-foot">
              {Calendar.strftime(m.inserted_at, "%a %b %-d")}
              <details :if={m.checked != []}>
                <summary>
                  · Looked at {length(m.checked)} {if length(m.checked) == 1,
                    do: "thing",
                    else: "things"} in his log
                </summary>
                <ul>
                  <li :for={c <- m.checked}>{c}</li>
                </ul>
              </details>
            </div>
          </article>
          <article :if={@coach_loading} class="tr-qa tr-qa-loading" id="coach-loading">
            <div class="tr-qa-q">
              <span class="tr-qa-label">You asked</span>
              <p>{@coach_loading}</p>
            </div>
            <div class="tr-qa-a">
              <span class="tr-dots-anim"><i></i><i></i><i></i></span>
              Checking his log… usually 5–20 seconds.
            </div>
          </article>
        </div>
        <div :if={cards > 1} class="tr-deck-nav">
          <button type="button" data-deck="prev" aria-label="Earlier answer">‹</button>
          <div :if={cards <= 10} class="tr-deck-dots" aria-hidden="true">
            <i :for={_ <- 1..cards}></i>
          </div>
          <span class="tr-deck-count" data-deck="count">{cards} of {cards}</span>
          <button type="button" data-deck="next" aria-label="Later answer">›</button>
        </div>
      </div>

      <p :if={@coach_error} class="tr-warn" style="margin-top:10px">{@coach_error}</p>

      <form
        id="coach-form"
        class="tr-composer"
        phx-submit="coach_ask"
        phx-change="coach_typing"
      >
        <textarea
          name="question"
          placeholder={
            if @coach_thread == [],
              do: "e.g. He won't give me his shoulder on the ground. How do I get through that?",
              else: "Ask a follow-up, or say “add that to my list”"
          }
          disabled={@coach_loading != nil}
        >{@coach_question}</textarea>
        <button
          type="submit"
          class="tr-btn tr-btn-primary tr-btn-block"
          disabled={@coach_loading != nil}
        >
          <%= cond do %>
            <% @coach_loading -> %>
              Looking through his log…
            <% @coach_thread != [] -> %>
              Ask follow-up
            <% true -> %>
              Ask
          <% end %>
        </button>
      </form>

      <details :if={@coach_thread == [] and is_nil(@coach_loading)} class="tr-more tr-ideas">
        <summary>Need an idea?</summary>
        <div class="tr-pills">
          <button
            :for={q <- coach_suggestions(@book)}
            type="button"
            class="tr-chip"
            phx-click="coach_suggest"
            phx-value-q={q}
          >
            {q}
          </button>
        </div>
      </details>

      <% current = @coach_thread |> List.first() |> then(&(&1 && &1.id)) %>
      <% earlier = Enum.reject(@coach_threads, &(&1.id == current)) %>
      <details :if={earlier != []} class="tr-more">
        <summary>Earlier conversations ({length(earlier)})</summary>
        <button
          :for={t <- earlier}
          type="button"
          class="tr-link-btn tr-earlier"
          phx-click="coach_open"
          phx-value-id={t.id}
          disabled={@coach_loading != nil}
        >
          {Calendar.strftime(t.inserted_at, "%b %-d")} · {t.question}
        </button>
      </details>
      <p class="tr-fine">Suggestions only. For anything that seems physical, talk to your vet.</p>
    <% else %>
      <p class="tr-muted">
        Not set up yet: the server needs an ANTHROPIC_API_KEY. Once it's added and the app restarts, you can ask here.
      </p>
    <% end %>
  </div>

  <%!-- Log a session --%>
  <div :if={@is_superuser} class="tr-card tr-sec sec-log" id="log" data-force-open={@editing && "1"}>
    <.section_head icon="hero-pencil-square" kind="log">
      {if @editing, do: "Edit session", else: "Log a session"}
      <:actions>
        <button :if={@editing} class="tr-link-btn" phx-click="cancel_edit">Cancel</button>
        <a
          :if={!@editing}
          href={~p"/training/lists?back=#{@book.id}"}
          class="tr-link-btn"
          style="text-decoration:none;display:inline-flex;align-items:center;gap:4px"
          aria-label="Customize lists"
        >
          <.icon name="hero-cog-6-tooth" class="tr-gear" /> Lists
        </a>
      </:actions>
    </.section_head>

    <%!-- Quick start --%>
    <div :if={!@editing and (@sessions != [] or @routines != [])} class="tr-quickstart">
      <span class="tr-label">Quick start</span>
      <button :if={@sessions != []} type="button" class="tr-mini" phx-click="repeat_last">
        ↻ Repeat last
      </button>
      <span :for={r <- @routines} class="tr-routine">
        <button
          type="button"
          class="tr-mini"
          phx-click="apply_routine"
          phx-value-id={r.id}
          title={activity_summary(r, @activities)}
        >
          {r.name}
        </button>
        <button
          :if={@managing_routines}
          type="button"
          class="tr-link-btn"
          phx-click="delete_routine"
          phx-value-id={r.id}
          data-confirm={"Delete the routine “#{r.name}”?"}
          aria-label={"Delete #{r.name}"}
        >
          ✕
        </button>
      </span>
      <button
        :if={@routines != []}
        type="button"
        class="tr-link-btn"
        phx-click="toggle_manage_routines"
      >
        {if @managing_routines, do: "Done", else: "Edit"}
      </button>
    </div>

    <%!-- Talk-to-log --%>
    <form
      :if={@coach_on and !@editing}
      id="voice-form"
      class="tr-voice"
      phx-submit="voice_fill"
      phx-change="voice_typing"
    >
      <div class="tr-voice-head">
        <.icon name="hero-microphone" />
        <span>Tell the Tr<span class="tr-ai">AI</span>ner what you did</span>
      </div>
      <textarea
        name="spoken"
        rows="3"
        placeholder="Tap the mic on your keyboard and talk: “20 minutes, groundwork and feet. Left hind was better, held it for five. Sticky going right.”"
        disabled={@voice_loading}
      >{@voice_text}</textarea>
      <div class="tr-voice-actions">
        <button type="submit" class="tr-mini solid" disabled={@voice_loading}>
          <%= if @voice_loading do %>
            <span class="tr-dots-anim"><i></i><i></i><i></i></span> Filling in…
          <% else %>
            <.icon name="hero-sparkles" /> Fill in the form
          <% end %>
        </button>
        <button
          :if={@voice_text != "" and not @voice_loading}
          type="button"
          class="tr-link-btn"
          phx-click="voice_clear"
        >
          Clear
        </button>
      </div>
      <%= case @voice_note do %>
        <% {:ok, []} -> %>
          <p class="tr-voice-note">
            Couldn't pick anything out of that. Try naming what you worked on.
          </p>
        <% {:ok, parts} -> %>
          <p class="tr-voice-note ok" id="voice-filled">
            ✓ Filled in {Enum.join(parts, ", ")}. Check it over below, then Save.
          </p>
        <% {:error, msg} -> %>
          <p class="tr-voice-note err">{msg}</p>
        <% nil -> %>
      <% end %>
    </form>

    <.form for={%{}} as={:session} id="session-form" phx-change="change" phx-submit="save">
      <div class="tr-step">
        <div class="tr-step-head"><span class="tr-step-n">1</span> When</div>
        <div class="tr-inline">
          <div class="tr-pills">
            <label :for={{iso, label} <- date_chips(@today)} class="tr-pill">
              <input
                type="radio"
                name="session[date_chip]"
                value={iso}
                checked={@params["date_chip"] == iso}
              />
              <span>{label}</span>
            </label>
          </div>
          <input
            type="date"
            id="session_date"
            name="session[date_typed]"
            value={@params["date_typed"]}
            max={Date.to_iso8601(@today)}
            aria-label="Or pick an earlier day"
          />
        </div>
        <p
          :if={@params["date"] not in [nil, ""] and @params["date_chip"] in [nil, ""]}
          class="tr-muted"
          style="font-size:14px;margin-top:6px"
        >
          Logging for {fmt_date(@params["date"], @today)}
        </p>
      </div>

      <div class="tr-step">
        <div class="tr-step-head">
          <span class="tr-step-n">2</span> What did you work on?
        </div>
        <input type="hidden" name="session[activity_ids][]" value="" />
        <div class="tr-pills">
          <label
            :for={a <- @activities}
            class={"tr-pill #{if MapSet.member?(@gated, a.slug) and @progress.stage && a.slug not in @progress.stage.session_types, do: "dim"}"}
          >
            <input
              type="checkbox"
              name="session[activity_ids][]"
              value={a.id}
              checked={"#{a.id}" in @params["activity_ids"]}
            />
            <span>{a.name}</span>
          </label>
        </div>

        <%!-- How each picked activity went (optional) --%>
        <% picked = Enum.filter(@activities, &("#{&1.id}" in @params["activity_ids"])) %>
        <div :if={picked != []} style="margin-top:12px">
          <div :for={a <- picked} class="tr-act" id={"detail-#{a.id}"}>
            <b>{a.name} <small class="tr-muted" style="font-weight:400">how did it go?</small></b>
            <div class="tr-seg">
              <label :for={{v, l} <- results()} class={"tr-pill res-#{v}"}>
                <input
                  type="radio"
                  name={"session[details][#{a.id}][result]"}
                  value={v}
                  checked={detail(@params, a.id, "result") == v}
                />
                <span>{l}</span>
              </label>
            </div>
            <div class="tr-seg">
              <label :for={{v, l} <- sides()} class="tr-pill">
                <input
                  type="radio"
                  name={"session[details][#{a.id}][side]"}
                  value={v}
                  checked={detail(@params, a.id, "side") == v}
                />
                <span>{l}</span>
              </label>
            </div>
            <input
              type="text"
              name={"session[details][#{a.id}][note]"}
              value={detail(@params, a.id, "note")}
              placeholder={"Note on #{String.downcase(a.name)} (optional)"}
              class="tr-detail-note"
            />
          </div>
        </div>
      </div>

      <% loggable = loggable_issues(@issues, @params) %>
      <div :if={loggable != []} class="tr-step">
        <div class="tr-step-head">
          <span class="tr-step-n">3</span> Working on <small>How did it go today?</small>
        </div>
        <div :for={i <- loggable} class="tr-mark-row" id={"mark-#{i.id}"}>
          <b>{i.title}</b>
          <div class="tr-seg">
            <label class="tr-pill mk-skip">
              <input
                type="radio"
                name={"session[issues][#{i.id}][progress]"}
                value=""
                checked={mark(@params, i.id, "progress") in [nil, ""]}
              />
              <span>Skip</span>
            </label>
            <label :for={{v, l} <- progress_options()} class={"tr-pill mk-#{v}"}>
              <input
                type="radio"
                name={"session[issues][#{i.id}][progress]"}
                value={v}
                checked={mark(@params, i.id, "progress") == v}
              />
              <span>{progress_icon(v)} {l}</span>
            </label>
          </div>
          <input
            :if={mark(@params, i.id, "progress") not in [nil, ""]}
            type="text"
            name={"session[issues][#{i.id}][note]"}
            value={mark(@params, i.id, "note")}
            placeholder="What you tried, what changed (optional)"
            class="tr-detail-note"
          />
        </div>
      </div>

      <div class="tr-step">
        <div class="tr-step-head">
          <span class="tr-step-n">{if loggable != [], do: 4, else: 3}</span>
          <label for="session_minutes">How long?</label> <small>minutes</small>
        </div>
        <div class="tr-inline">
          <div class="tr-pills">
            <label :for={m <- @minute_chips} class="tr-pill">
              <input
                type="radio"
                name="session[minute_chip]"
                value={m}
                checked={"#{@params["minute_chip"]}" == "#{m}"}
              />
              <span>{m}</span>
            </label>
          </div>
          <input
            type="number"
            id="session_minutes"
            name="session[minutes_typed]"
            inputmode="numeric"
            min="1"
            max="600"
            value={@params["minutes_typed"]}
            placeholder="Other"
          />
        </div>
        <button
          type="button"
          id={"session-timer-#{@book.id}"}
          class="tr-timer"
          phx-hook="SessionTimer"
          phx-update="ignore"
          data-key={"ranch:timer:#{@book.id}"}
        >
          <.icon name="hero-clock" /> <span data-timer-label>Start a timer</span>
        </button>
      </div>

      <div class="tr-step">
        <div class="tr-step-head">
          <span class="tr-step-n">{if loggable != [], do: 5, else: 4}</span>
          How was he? <small>optional</small>
        </div>
        <input type="hidden" name="session[tags][]" value="" />
        <div class="tr-pills tr-pills-sm">
          <label
            :for={t <- Enum.filter(@tags, &(not &1.archived or &1.slug in @params["tags"]))}
            class={"tr-pill tag-#{t.kind}"}
          >
            <input
              type="checkbox"
              name="session[tags][]"
              value={t.slug}
              checked={t.slug in @params["tags"]}
            />
            <span>{t.name}</span>
          </label>
        </div>
      </div>

      <div class="tr-step">
        <div class="tr-step-head">
          <label for="session_note">Note and photos</label> <small>optional</small>
        </div>
        <textarea
          id="session_note"
          name="session[note]"
          class="tr-detail-note"
          style="min-height:84px;margin-bottom:8px"
          placeholder="What worked, what to try next time…"
        >{@params["note"]}</textarea>
        <div :if={@editing_photos != []} class="tr-thumbs" style="margin:0 0 8px">
          <div :for={p <- @editing_photos} class="tr-thumb" id={"edit-photo-#{p.id}"}>
            <img src={p.url} alt="Session photo" loading="lazy" />
            <button
              type="button"
              class="tr-thumb-x"
              phx-click="remove_photo"
              phx-value-id={p.id}
              data-confirm="Remove this photo?"
              aria-label="Remove photo"
            >
              ✕
            </button>
          </div>
        </div>
        <.photo_picker
          upload={@uploads.session_photos}
          label="Add photos"
          cancel_event="cancel_session_photo"
        />
      </div>

      <div :for={w <- @warnings} class="tr-warn" style="margin-bottom:10px">{w}</div>
      <div :for={e <- @errors} class="tr-error" style="margin-bottom:10px">{e}</div>
      <p
        :if={Enum.any?(@params["tags"], &health_tag?(@tags, &1))}
        class="tr-muted"
        style="margin-bottom:10px"
      >
        If he's sore or off, give him rest and check with your vet before the next session.
      </p>

      <button
        type="submit"
        class="tr-btn tr-btn-primary tr-btn-block"
        phx-disable-with="Saving…"
      >
        {if @editing, do: "Save changes", else: "Save session"}
      </button>
    </.form>

    <div :if={!@editing} style="margin-top:12px">
      <%= if @naming_routine do %>
        <form phx-submit="create_routine" class="tr-row" style="flex-wrap:nowrap">
          <input
            type="text"
            name="name"
            placeholder="Routine name, e.g. Usual groundwork"
            class="tr-detail-note"
            style="flex:1"
            autofocus
            required
          />
          <button type="submit" class="tr-btn tr-btn-small">Save</button>
          <button type="button" class="tr-link-btn" phx-click="cancel_routine">Cancel</button>
        </form>
        <p class="tr-muted" style="font-size:14px;margin-top:4px">
          Saves the activities, minutes and tags picked above as a one-tap routine for {@book.horse.name}.
        </p>
        <p :if={@routine_error} class="tr-error">{@routine_error}</p>
      <% else %>
        <button type="button" class="tr-link-btn" style="padding:0" phx-click="name_routine">
          + Save these picks as a routine
        </button>
      <% end %>
    </div>
  </div>

  <%!-- Session history --%>
  <div class="tr-card tr-sec sec-sessions" id="sessions">
    <.section_head icon="hero-calendar-days" kind="sessions">
      Sessions
      <:actions>
        <span :if={@sessions != []} class="tr-count">{length(@sessions)} logged</span>
      </:actions>
    </.section_head>
    <p :if={@sessions == []} class="tr-muted">Nothing logged yet.</p>
    <div :for={s <- @sessions} class="tr-sess" id={"session-#{s.id}"}>
      <div class="tr-date" title={fmt_date(s.date, @today)}>
        <small>{Calendar.strftime(s.date, "%a")}</small>
        <b>{Calendar.strftime(s.date, "%-d")}</b>
        <small>{Calendar.strftime(s.date, "%b")}</small>
      </div>
      <div style="min-width:0">
        <div class="tr-sess-title">
          {Enum.map_join(s.activities, ", ", & &1.activity.name)}<span :if={s.minutes}> · {s.minutes} min</span>
        </div>
        <div
          :for={a <- Enum.filter(s.activities, &(&1.result || &1.side || &1.note))}
          class="tr-sess-line"
        >
          {a.activity.name}:
          <span :if={a.result} class={"tr-res res-#{a.result}"}>
            {String.capitalize(a.result)}
          </span>
          <span :if={a.side}>{side_label(a.side)}</span>
          <span :if={a.note}>· {a.note}</span>
        </div>
        <div :for={m <- s.issue_marks} class="tr-sess-line">
          {m.issue.title}:
          <b class={"tr-res mk-#{m.progress}"}>
            {progress_icon(m.progress)} {String.capitalize(m.progress)}
          </b>
          <span :if={m.note}>· {m.note}</span>
        </div>
        <div :if={s.tags != []}>
          <span :for={t <- s.tags} class={"tr-tag #{if health_tag?(@tags, t), do: "sore"}"}>
            {tag_name(@tags, t)}
          </span>
        </div>
        <p :if={s.note && s.note != ""} class="tr-sess-note">{s.note}</p>
        <div :if={s.photos != []} class="tr-thumbs">
          <button
            :for={p <- s.photos}
            type="button"
            class="tr-thumb"
            phx-click="open_photo"
            phx-value-url={p.url}
            aria-label="View photo"
          >
            <img src={p.url} alt="Session photo" loading="lazy" />
          </button>
        </div>
        <div :if={@is_superuser} class="tr-sess-actions">
          <a
            href="#log"
            class="tr-link-btn"
            style="display:inline-flex;align-items:center;text-decoration:none"
            phx-click="edit_session"
            phx-value-id={s.id}
          >
            Edit
          </a>
          <button
            class="tr-link-btn"
            phx-click="delete_session"
            phx-value-id={s.id}
            data-confirm="Delete this session?"
          >
            Delete
          </button>
        </div>
      </div>
    </div>
  </div>
</div>

<div
  :if={@lightbox}
  class="tr-lightbox"
  id="lightbox"
  phx-click="close_photo"
  phx-window-keydown="close_photo"
  phx-key="Escape"
>
  <img src={@lightbox} alt="Session photo" />
  <button type="button" class="tr-lightbox-close" phx-click="close_photo" aria-label="Close">
    ✕
  </button>
</div>
