<.styles />
<.topbar back={~p"/training"} back_label="Training" title={@book.horse.name} />

<div class="tr-wrap">
  <div
    :if={Phoenix.Flash.get(@flash, :info)}
    class="tr-guard"
    style="font-weight:600"
    phx-click="lv:clear-flash"
    phx-value-key="info"
  >
    {Phoenix.Flash.get(@flash, :info)}
  </div>

  <%!-- The horse --%>
  <div class="tr-card" id="profile">
    <%= if @profile_form do %>
      <div class="tr-row" style="margin-bottom:14px">
        <h2>Edit profile</h2>
        <button class="tr-link-btn" phx-click="cancel_profile">Cancel</button>
      </div>
      <.form
        for={@profile_form}
        as={:horse}
        id="profile-form"
        phx-change="validate_profile"
        phx-submit="save_profile"
      >
        <div class="tr-field">
          <label for="horse_name">Name</label>
          <input
            type="text"
            id="horse_name"
            name="horse[name]"
            value={@profile_form[:name].value}
            required
          />
          <span :for={{msg, _} <- @profile_form[:name].errors} class="tr-error">{msg}</span>
        </div>
        <div class="tr-field">
          <label for="horse_foaled_on">Foaling date</label>
          <input
            type="date"
            id="horse_foaled_on"
            name="horse[foaled_on]"
            value={@profile_form[:foaled_on].value}
          />
        </div>
        <div class="tr-field">
          <label for="horse_sex">Sex</label>
          <select id="horse_sex" name="horse[sex]">
            <option value="">–</option>
            <option
              :for={
                {v, l} <- [
                  {"stallion", "Stud / colt"},
                  {"gelding", "Gelding"},
                  {"mare", "Mare / filly"}
                ]
              }
              value={v}
              selected={@profile_form[:sex].value == v}
            >
              {l}
            </option>
          </select>
        </div>
        <div class="tr-field">
          <label for="horse_owner">Owner</label>
          <input
            type="text"
            id="horse_owner"
            name="horse[owner]"
            value={@profile_form[:owner].value}
          />
        </div>
        <div class="tr-two">
          <div class="tr-field">
            <label for="horse_breed">Breed</label>
            <input
              type="text"
              id="horse_breed"
              name="horse[breed]"
              value={@profile_form[:breed].value}
            />
          </div>
          <div class="tr-field">
            <label for="horse_color">Color</label>
            <input
              type="text"
              id="horse_color"
              name="horse[color]"
              value={@profile_form[:color].value}
            />
          </div>
        </div>
        <div class="tr-field">
          <label for="horse_notes">Notes</label>
          <textarea
            id="horse_notes"
            name="horse[notes]"
            placeholder="Background, quirks, what the owner wants…"
          >{@profile_form[:notes].value}</textarea>
        </div>
        <div class="tr-field">
          <span class="tr-label">Photo</span>
          <.photo_picker
            upload={@uploads.photo}
            label={if @book.horse.photo_url, do: "Change photo", else: "Take or choose a photo"}
          />
        </div>
        <button
          type="submit"
          class="tr-btn tr-btn-primary tr-btn-block"
          phx-disable-with="Saving…"
        >
          Save profile
        </button>
      </.form>
    <% else %>
      <div class="tr-horse-head">
        <.horse_photo horse={@book.horse} size={88} />
        <div style="flex:1;min-width:0">
          <h2>{@book.horse.name}</h2>
          <p class="tr-muted">
            {[
              Training.age_label(@progress.age_months),
              sex_label(@book.horse.sex),
              @book.horse.color,
              @book.horse.breed
            ]
            |> Enum.reject(&(&1 in [nil, ""]))
            |> Enum.join(" · ")}
          </p>
          <p :if={@book.horse.owner} class="tr-muted">Owner: {@book.horse.owner}</p>
          <a
            :if={@book.horse.animal_id}
            href={~p"/animals/#{@book.horse.animal_id}"}
            class="tr-muted"
            style="color:var(--brand)"
          >
            Ranch record →
          </a>
        </div>
      </div>
      <p
        :if={@book.horse.notes && @book.horse.notes != ""}
        style="margin-top:10px;white-space:pre-line"
      >
        {@book.horse.notes}
      </p>
      <button
        :if={@is_superuser}
        class="tr-btn tr-btn-small"
        style="margin-top:12px"
        phx-click="edit_profile"
      >
        Edit profile
      </button>
    <% end %>
  </div>

  <%!-- Goals --%>
  <div class="tr-card" id="goals">
    <div class="tr-row" style="margin-bottom:6px">
      <h2>Goals</h2>
      <button
        :if={@is_superuser and is_nil(@editing_goal)}
        class="tr-btn tr-btn-small"
        phx-click="new_goal"
      >
        + Add goal
      </button>
    </div>

    <.goal_form :if={@editing_goal == :new} form={@goal_form} new />

    <% active = Enum.filter(@book.goals, &(&1.status == "active")) %>
    <% finished = Enum.reject(@book.goals, &(&1.status == "active")) %>
    <p :if={active == [] and @editing_goal != :new} class="tr-muted">
      No goals yet. Add what you're working toward: a show, a skill, a date.
    </p>

    <div :for={g <- active} class="tr-session" id={"goal-#{g.id}"}>
      <%= if @editing_goal == g.id do %>
        <.goal_form form={@goal_form} goal_id={g.id} />
      <% else %>
        <b>{g.title}</b>
        <p :if={goal_when(g, @today)} class="tr-muted">{goal_when(g, @today)}</p>
        <p :if={g.notes && g.notes != ""} style="margin-top:4px;white-space:pre-line">
          {g.notes}
        </p>
        <div :if={@is_superuser} class="tr-row" style="justify-content:flex-start;margin-top:6px">
          <button
            class="tr-btn tr-btn-small"
            phx-click="goal_status"
            phx-value-id={g.id}
            phx-value-status="done"
          >
            ✓ Done
          </button>
          <button class="tr-btn tr-btn-small" phx-click="edit_goal" phx-value-id={g.id}>
            Edit
          </button>
        </div>
      <% end %>
    </div>

    <button
      :if={finished != []}
      class="tr-link-btn"
      style="padding:0;margin-top:8px"
      phx-click="toggle_done_goals"
    >
      {if @show_done_goals, do: "Hide", else: "Show"} finished goals ({length(finished)})
    </button>
    <div :for={g <- finished} :if={@show_done_goals} class="tr-session" style="opacity:.75">
      <b>{g.title}</b>
      <p class="tr-muted">
        {if g.status == "done",
          do: "Done#{if g.done_on, do: " " <> Calendar.strftime(g.done_on, "%b %-d, %Y")}",
          else: "Dropped"}
      </p>
      <div :if={@is_superuser} class="tr-row" style="justify-content:flex-start;margin-top:4px">
        <button
          class="tr-link-btn"
          style="padding:0"
          phx-click="goal_status"
          phx-value-id={g.id}
          phx-value-status="active"
        >
          Reopen
        </button>
      </div>
    </div>
  </div>

  <%!-- Working on --%>
  <div class="tr-card" id="working-on">
    <div class="tr-row" style="margin-bottom:6px">
      <h2>Working on</h2>
      <button
        :if={@is_superuser and is_nil(@editing_issue)}
        class="tr-btn tr-btn-small"
        phx-click="new_issue"
      >
        + Add
      </button>
    </div>

    <.issue_form :if={@editing_issue == :new} form={@issue_form} activities={@activities} />

    <% open = Enum.reject(@issues, &(&1.status == "solved")) %>
    <% solved = Enum.filter(@issues, &(&1.status == "solved")) %>
    <p :if={open == [] and @editing_issue != :new} class="tr-muted">
      Nothing yet. Add a problem you're working through, like “Picking up left hind”. Each
      session can mark it better, same or worse.
    </p>

    <div
      :for={i <- open ++ if(@show_solved, do: solved, else: [])}
      class="tr-session"
      id={"issue-#{i.id}"}
    >
      <%= if @editing_issue == i.id do %>
        <.issue_form form={@issue_form} activities={@activities} issue_id={i.id} />
      <% else %>
        <div class="tr-row">
          <b>{i.title}</b>
          <span class={"tr-status st-#{i.status}"}>{String.capitalize(i.status)}</span>
        </div>
        <p :if={issue_meta(i) != ""} class="tr-muted">{issue_meta(i)}</p>
        <p class="tr-muted" style="font-size:14px">
          Since {Calendar.strftime(i.opened_on, "%b %-d")}
          <span :if={i.solved_on}>· solved {Calendar.strftime(i.solved_on, "%b %-d")}</span>
          <span :if={i.marks != []}>
            · {length(i.marks)} {if length(i.marks) == 1, do: "session", else: "sessions"}
          </span>
        </p>
        <div :if={i.marks != []} class="tr-trend" aria-label="Last sessions, newest first">
          <span
            :for={m <- Enum.take(i.marks, 8)}
            class={"tr-mark mk-#{m.progress}"}
            title={"#{fmt_date(m.session.date, @today)}: #{m.progress}"}
          >
            {progress_icon(m.progress)}
          </span>
        </div>
        <p :if={i.notes && i.notes != ""} style="margin-top:4px;white-space:pre-line">
          {i.notes}
        </p>

        <div :if={@issue_history == i.id} class="tr-history">
          <div :for={m <- i.marks} class="tr-muted" style="font-size:15px">
            <b class={"tr-res mk-#{m.progress}"}>
              {progress_icon(m.progress)} {String.capitalize(m.progress)}
            </b>
            · {fmt_date(m.session.date, @today)}<span :if={m.note}> · {m.note}</span>
          </div>
        </div>

        <div class="tr-row" style="justify-content:flex-start;gap:4px;margin-top:6px">
          <button
            :if={i.marks != []}
            class="tr-link-btn"
            style="padding-left:0"
            phx-click="toggle_issue_history"
            phx-value-id={i.id}
          >
            {if @issue_history == i.id, do: "Hide history", else: "History"}
          </button>
          <%= if @is_superuser do %>
            <button
              :for={{v, l} <- issue_statuses()}
              :if={v != i.status}
              class="tr-btn tr-btn-small"
              phx-click="issue_status"
              phx-value-id={i.id}
              phx-value-status={v}
            >
              {if v == "solved", do: "✓ Solved", else: l}
            </button>
            <button class="tr-link-btn" phx-click="edit_issue" phx-value-id={i.id}>Edit</button>
          <% end %>
        </div>
      <% end %>
    </div>

    <button
      :if={solved != []}
      class="tr-link-btn"
      style="padding:0;margin-top:8px"
      phx-click="toggle_solved"
    >
      {if @show_solved, do: "Hide", else: "Show"} solved ({length(solved)})
    </button>
  </div>

  <%!-- Where he is now --%>
  <div class="tr-card" id="now">
    <div class="tr-label">
      Now · {Training.age_label(@progress.age_months)}
      <span :if={@progress.stage}>
        · Stage {@progress.stage_number} of {@progress.stage_count}
      </span>
    </div>
    <%= if @progress.stage do %>
      <h2>{@progress.stage.name}</h2>
      <p class="tr-muted" style="margin-top:4px">{@progress.stage.summary}</p>
      <ul class="tr-list">
        <li :for={f <- @progress.stage.focus}>{f}</li>
      </ul>
      <div class="tr-guard">
        <b>Keep it light:</b> {@progress.stage.guardrail}
        <span :if={@progress.stage.max_session_minutes}>
          Up to {@progress.stage.max_session_minutes} min a session<span :if={
            @progress.stage.max_sessions_per_week
          }>, {@progress.stage.max_sessions_per_week} sessions a week</span>.
        </span>
      </div>
      <p
        :if={
          (@progress.overridden? and @progress.by_age) &&
            @progress.by_age.id != @progress.stage.id
        }
        class="tr-muted"
        style="margin-top:10px"
      >
        Set by hand. By age he'd be in “{@progress.by_age.name}”.
      </p>
    <% end %>
    <p :if={is_nil(@book.horse.foaled_on)} class="tr-warn" style="margin-top:12px">
      No foaling date yet, so the stage can't follow his age. Add it with Edit profile.
    </p>

    <div class="tr-stats">
      <div class="tr-stat"><b>{@week.sessions}</b><span>sessions, 7 days</span></div>
      <div class="tr-stat"><b>{@week.minutes}</b><span>minutes, 7 days</span></div>
      <div class="tr-stat">
        <b>{if @progress.days_to_goal, do: @progress.days_to_goal, else: "–"}</b>
        <span>days to goal</span>
      </div>
    </div>
    <p :if={@progress.next_goal} class="tr-muted" style="margin-top:10px">
      Next goal: {@progress.next_goal.title}
    </p>
  </div>

  <%!-- What's next --%>
  <div :if={@progress.next} class="tr-card">
    <div class="tr-label">Next</div>
    <h2>{@progress.next.name}</h2>
    <p class="tr-muted" style="margin-top:4px">
      <%= cond do %>
        <% @progress.months_to_next == nil -> %>
          From {@progress.next.from_age_months} months.
        <% @progress.months_to_next == 0 -> %>
          He's old enough now. Move on when he's ready.
        <% true -> %>
          From {@progress.next.from_age_months} months, about {@progress.months_to_next} {if @progress.months_to_next ==
                                                                                               1,
                                                                                             do:
                                                                                               "month",
                                                                                             else:
                                                                                               "months"} away.
      <% end %>
    </p>
    <div :if={@is_superuser} class="tr-row" style="margin-top:12px;justify-content:flex-start">
      <button class="tr-btn tr-btn-small" phx-click="set_stage" phx-value-id={@progress.next.id}>
        Ready: move to this stage
      </button>
      <button :if={@progress.overridden?} class="tr-btn tr-btn-small" phx-click="set_stage">
        Follow his age again
      </button>
    </div>
  </div>
  <div :if={is_nil(@progress.next) and @progress.overridden? and @is_superuser} class="tr-card">
    <button class="tr-btn tr-btn-small" phx-click="set_stage">Follow his age again</button>
  </div>

  <%!-- Log a session --%>
  <div :if={@is_superuser} class="tr-card" id="log">
    <div class="tr-row" style="margin-bottom:12px">
      <h2>{if @editing, do: "Edit session", else: "Log a session"}</h2>
      <button :if={@editing} class="tr-link-btn" phx-click="cancel_edit">Cancel</button>
      <a
        :if={!@editing}
        href={~p"/training/lists?back=#{@book.id}"}
        class="tr-link-btn"
        style="text-decoration:none;display:inline-flex;align-items:center"
      >
        Customize lists
      </a>
    </div>

    <%!-- Quick actions --%>
    <div :if={!@editing} class="tr-quick">
      <button
        :if={@sessions != []}
        type="button"
        class="tr-btn tr-btn-small"
        phx-click="repeat_last"
      >
        ↻ Repeat last
      </button>
      <span :for={r <- @routines} class="tr-routine">
        <button
          type="button"
          class="tr-btn tr-btn-small"
          phx-click="apply_routine"
          phx-value-id={r.id}
          title={activity_summary(r, @activities)}
        >
          {r.name}
        </button>
        <button
          :if={@managing_routines}
          type="button"
          class="tr-link-btn"
          phx-click="delete_routine"
          phx-value-id={r.id}
          data-confirm={"Delete the routine “#{r.name}”?"}
          aria-label={"Delete #{r.name}"}
        >
          ✕
        </button>
      </span>
      <button
        :if={@routines != []}
        type="button"
        class="tr-link-btn"
        phx-click="toggle_manage_routines"
      >
        {if @managing_routines, do: "Done", else: "Edit routines"}
      </button>
    </div>

    <.form for={%{}} as={:session} id="session-form" phx-change="change" phx-submit="save">
      <div class="tr-field">
        <span class="tr-label">When?</span>
        <div class="tr-pills">
          <label :for={{iso, label} <- date_chips(@today)} class="tr-pill">
            <input
              type="radio"
              name="session[date_chip]"
              value={iso}
              checked={@params["date_chip"] == iso}
            />
            <span>{label}</span>
          </label>
        </div>
        <input
          type="date"
          id="session_date"
          name="session[date_typed]"
          value={@params["date_typed"]}
          max={Date.to_iso8601(@today)}
          aria-label="Or pick an earlier day"
        />
        <span class="tr-muted" style="font-size:14px">
          Logging for {fmt_date(@params["date"], @today)}
        </span>
      </div>

      <div class="tr-field">
        <span class="tr-label">
          What did you work on?
          <span class="tr-muted" style="font-weight:400">Pick all that apply</span>
        </span>
        <input type="hidden" name="session[activity_ids][]" value="" />
        <div class="tr-pills">
          <label
            :for={a <- @activities}
            class={"tr-pill #{if MapSet.member?(@gated, a.slug) and @progress.stage && a.slug not in @progress.stage.session_types, do: "dim"}"}
          >
            <input
              type="checkbox"
              name="session[activity_ids][]"
              value={a.id}
              checked={"#{a.id}" in @params["activity_ids"]}
            />
            <span>{a.name}</span>
          </label>
        </div>
      </div>

      <%!-- How each picked activity went (optional) --%>
      <% picked = Enum.filter(@activities, &("#{&1.id}" in @params["activity_ids"])) %>
      <div :for={a <- picked} class="tr-detail" id={"detail-#{a.id}"}>
        <b>{a.name}</b>
        <div class="tr-pills tr-pills-sm">
          <label :for={{v, l} <- results()} class={"tr-pill res-#{v}"}>
            <input
              type="radio"
              name={"session[details][#{a.id}][result]"}
              value={v}
              checked={detail(@params, a.id, "result") == v}
            />
            <span>{l}</span>
          </label>
        </div>
        <div class="tr-pills tr-pills-sm">
          <label :for={{v, l} <- sides()} class="tr-pill">
            <input
              type="radio"
              name={"session[details][#{a.id}][side]"}
              value={v}
              checked={detail(@params, a.id, "side") == v}
            />
            <span>{l}</span>
          </label>
        </div>
        <input
          type="text"
          name={"session[details][#{a.id}][note]"}
          value={detail(@params, a.id, "note")}
          placeholder={"Note on #{String.downcase(a.name)} (optional)"}
          class="tr-detail-note"
        />
      </div>

      <% loggable = loggable_issues(@issues, @params) %>
      <div :if={loggable != []} class="tr-field">
        <span class="tr-label">
          Working on <span class="tr-muted" style="font-weight:400">How did it go today?</span>
        </span>
        <div :for={i <- loggable} class="tr-detail" style="margin:0" id={"mark-#{i.id}"}>
          <b>{i.title}</b>
          <div class="tr-pills tr-pills-sm">
            <label class="tr-pill">
              <input
                type="radio"
                name={"session[issues][#{i.id}][progress]"}
                value=""
                checked={mark(@params, i.id, "progress") in [nil, ""]}
              />
              <span>Not today</span>
            </label>
            <label :for={{v, l} <- progress_options()} class={"tr-pill mk-#{v}"}>
              <input
                type="radio"
                name={"session[issues][#{i.id}][progress]"}
                value={v}
                checked={mark(@params, i.id, "progress") == v}
              />
              <span>{l}</span>
            </label>
          </div>
          <input
            :if={mark(@params, i.id, "progress") not in [nil, ""]}
            type="text"
            name={"session[issues][#{i.id}][note]"}
            value={mark(@params, i.id, "note")}
            placeholder="What you tried, what changed (optional)"
            class="tr-detail-note"
          />
        </div>
      </div>

      <div class="tr-field">
        <label for="session_minutes">Minutes</label>
        <div class="tr-pills">
          <label :for={m <- @minute_chips} class="tr-pill">
            <input
              type="radio"
              name="session[minute_chip]"
              value={m}
              checked={"#{@params["minute_chip"]}" == "#{m}"}
            />
            <span>{m}</span>
          </label>
        </div>
        <input
          type="number"
          id="session_minutes"
          name="session[minutes_typed]"
          inputmode="numeric"
          min="1"
          max="600"
          value={@params["minutes_typed"]}
          placeholder="Or type minutes"
        />
      </div>

      <div class="tr-field">
        <span class="tr-label">How was he?</span>
        <input type="hidden" name="session[tags][]" value="" />
        <div class="tr-pills">
          <label
            :for={t <- Enum.filter(@tags, &(not &1.archived or &1.slug in @params["tags"]))}
            class={"tr-pill tag-#{t.kind}"}
          >
            <input
              type="checkbox"
              name="session[tags][]"
              value={t.slug}
              checked={t.slug in @params["tags"]}
            />
            <span>{t.name}</span>
          </label>
        </div>
      </div>

      <div class="tr-field">
        <label for="session_note">Note</label>
        <textarea
          id="session_note"
          name="session[note]"
          placeholder="What worked, what to try next time…"
        >{@params["note"]}</textarea>
      </div>

      <div class="tr-field">
        <span class="tr-label">Photos</span>
        <div :if={@editing_photos != []} class="tr-thumbs" style="margin:0 0 8px">
          <div :for={p <- @editing_photos} class="tr-thumb" id={"edit-photo-#{p.id}"}>
            <img src={p.url} alt="Session photo" loading="lazy" />
            <button
              type="button"
              class="tr-thumb-x"
              phx-click="remove_photo"
              phx-value-id={p.id}
              data-confirm="Remove this photo?"
              aria-label="Remove photo"
            >
              ✕
            </button>
          </div>
        </div>
        <.photo_picker
          upload={@uploads.session_photos}
          label="Add photos"
          cancel_event="cancel_session_photo"
        />
      </div>

      <div :for={w <- @warnings} class="tr-warn" style="margin-bottom:10px">{w}</div>
      <div :for={e <- @errors} class="tr-error" style="margin-bottom:10px">{e}</div>
      <p
        :if={Enum.any?(@params["tags"], &health_tag?(@tags, &1))}
        class="tr-muted"
        style="margin-bottom:10px"
      >
        If he's sore or off, give him rest and check with your vet before the next session.
      </p>

      <button
        type="submit"
        class="tr-btn tr-btn-primary tr-btn-block"
        phx-disable-with="Saving…"
      >
        {if @editing, do: "Save changes", else: "Save session"}
      </button>
    </.form>

    <div :if={!@editing} style="margin-top:12px">
      <%= if @naming_routine do %>
        <form phx-submit="create_routine" class="tr-row" style="flex-wrap:nowrap">
          <input
            type="text"
            name="name"
            placeholder="Routine name, e.g. Usual groundwork"
            class="tr-detail-note"
            style="flex:1"
            autofocus
            required
          />
          <button type="submit" class="tr-btn tr-btn-small">Save</button>
          <button type="button" class="tr-link-btn" phx-click="cancel_routine">Cancel</button>
        </form>
        <p class="tr-muted" style="font-size:14px;margin-top:4px">
          Saves the activities, minutes and tags picked above as a one-tap routine for {@book.horse.name}.
        </p>
        <p :if={@routine_error} class="tr-error">{@routine_error}</p>
      <% else %>
        <button type="button" class="tr-link-btn" style="padding:0" phx-click="name_routine">
          + Save these picks as a routine
        </button>
      <% end %>
    </div>
  </div>

  <%!-- Session history --%>
  <div class="tr-card" id="sessions">
    <h2 style="margin-bottom:10px">Sessions</h2>
    <p :if={@sessions == []} class="tr-muted">Nothing logged yet.</p>
    <div :for={s <- @sessions} class="tr-session" id={"session-#{s.id}"}>
      <div class="tr-row">
        <b>
          {Enum.map_join(s.activities, ", ", & &1.activity.name)}<span
            :if={s.minutes}
            class="tr-muted"
            style="font-weight:400"
          > · {s.minutes} min</span>
        </b>
        <span class="tr-muted">{fmt_date(s.date, @today)}</span>
      </div>
      <div
        :for={a <- Enum.filter(s.activities, &(&1.result || &1.side || &1.note))}
        class="tr-muted"
        style="font-size:15px;margin-top:2px"
      >
        {a.activity.name}:
        <span :if={a.result} class={"tr-res res-#{a.result}"}>{String.capitalize(a.result)}</span>
        <span :if={a.side}>{String.capitalize(a.side)} side</span>
        <span :if={a.note}>· {a.note}</span>
      </div>
      <div :for={m <- s.issue_marks} class="tr-muted" style="font-size:15px;margin-top:2px">
        {m.issue.title}:
        <b class={"tr-res mk-#{m.progress}"}>
          {progress_icon(m.progress)} {String.capitalize(m.progress)}
        </b>
        <span :if={m.note}>· {m.note}</span>
      </div>
      <div :if={s.tags != []}>
        <span :for={t <- s.tags} class={"tr-tag #{if health_tag?(@tags, t), do: "sore"}"}>
          {tag_name(@tags, t)}
        </span>
      </div>
      <p :if={s.note && s.note != ""} style="margin-top:6px;white-space:pre-line">{s.note}</p>
      <div :if={s.photos != []} class="tr-thumbs">
        <button
          :for={p <- s.photos}
          type="button"
          class="tr-thumb"
          phx-click="open_photo"
          phx-value-url={p.url}
          aria-label="View photo"
        >
          <img src={p.url} alt="Session photo" loading="lazy" />
        </button>
      </div>
      <div
        :if={@is_superuser}
        class="tr-row"
        style="justify-content:flex-start;gap:4px;margin-top:4px"
      >
        <a
          href="#log"
          class="tr-link-btn"
          style="padding:0;display:inline-flex;align-items:center;text-decoration:none"
          phx-click="edit_session"
          phx-value-id={s.id}
        >
          Edit
        </a>
        <button
          class="tr-link-btn"
          phx-click="delete_session"
          phx-value-id={s.id}
          data-confirm="Delete this session?"
        >
          Delete
        </button>
      </div>
    </div>
  </div>
</div>

<div
  :if={@lightbox}
  class="tr-lightbox"
  id="lightbox"
  phx-click="close_photo"
  phx-window-keydown="close_photo"
  phx-key="Escape"
>
  <img src={@lightbox} alt="Session photo" />
  <button type="button" class="tr-lightbox-close" phx-click="close_photo" aria-label="Close">
    ✕
  </button>
</div>
