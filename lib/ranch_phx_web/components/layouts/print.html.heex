<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1"/>
  <title>Report — <%= assigns[:report_title] || "Gimel Ranch" %></title>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: Georgia, 'Times New Roman', serif; color: #111; background: #fff; font-size: 11pt; line-height: 1.5; }
    .print-page { max-width: 8in; margin: 0 auto; padding: 0.5in 0.75in; }
    .no-print { background: #f3f4f6; border-bottom: 1px solid #e5e7eb; padding: 10px 16px; display: flex; align-items: center; gap: 12px; font-family: -apple-system, sans-serif; }
    .no-print button { padding: 8px 16px; border-radius: 6px; border: none; cursor: pointer; font-size: 13px; font-weight: 600; }
    .btn-print { background: #8b5cf6; color: #fff; }
    .btn-close { background: #e5e7eb; color: #111; }
    .btn-back { background: none; color: #6d28d9; padding-left: 0 !important; }
    .no-print { position: sticky; top: 0; z-index: 10; padding-top: calc(10px + env(safe-area-inset-top)) !important; }
    .no-print button { min-height: 40px; font-size: 15px !important; }
    .rpt-chart { width: 100%; height: auto; display: block; margin: 4pt 0 10pt; }
    .rpt-chart .grid { stroke: #e5e7eb; stroke-width: 1; }
    .rpt-chart .axis { font-size: 10px; fill: #6b7280; font-family: -apple-system, Helvetica, sans-serif; }
    .rpt-chart .line { fill: none; stroke: #15803d; stroke-width: 2.5; stroke-linejoin: round; }
    .rpt-chart .dot { fill: #15803d; }
    .rpt-chart .val { font-size: 9px; fill: #111; font-family: -apple-system, Helvetica, sans-serif; font-weight: bold; }
    .rpt-weight-stats { display: flex; gap: 24pt; margin-bottom: 6pt; font-size: 10pt; }
    .rpt-weight-stats b { display: block; font-size: 14pt; }
    .num { text-align: right; white-space: nowrap; }
    .rpt-header { border-bottom: 2px solid #111; padding-bottom: 12px; margin-bottom: 20px; display: flex; justify-content: space-between; align-items: flex-end; }
    .rpt-title { font-size: 22pt; font-weight: bold; }
    .rpt-subtitle { font-size: 11pt; color: #555; margin-top: 2px; }
    .rpt-meta { font-size: 9pt; color: #777; text-align: right; }
    .rpt-section { margin-bottom: 24pt; }
    .rpt-section-title { font-size: 13pt; font-weight: bold; text-transform: uppercase; letter-spacing: 0.06em; border-bottom: 1px solid #ccc; padding-bottom: 4pt; margin-bottom: 10pt; color: #333; }
    .rpt-table { width: 100%; border-collapse: collapse; font-size: 10pt; }
    .rpt-table th { text-align: left; font-weight: bold; padding: 5pt 8pt; border-bottom: 1.5pt solid #ccc; font-size: 9pt; text-transform: uppercase; letter-spacing: 0.05em; color: #555; }
    .rpt-table td { padding: 5pt 8pt; border-bottom: 0.5pt solid #e5e7eb; vertical-align: top; }
    .rpt-table tr:last-child td { border-bottom: none; }
    .tag { display: inline-block; background: #f3f4f6; border: 1px solid #d1d5db; border-radius: 3pt; padding: 1pt 5pt; font-size: 8pt; margin-right: 3pt; }
    .ped-grid { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 0; border: 1pt solid #ccc; font-size: 10pt; }
    .ped-cell { padding: 6pt 8pt; border-right: 1pt solid #ccc; border-bottom: 1pt solid #ccc; }
    .ped-cell:last-child, .ped-cell:nth-child(3n) { border-right: none; }
    .ped-label { font-size: 8pt; text-transform: uppercase; letter-spacing: 0.05em; color: #777; margin-bottom: 2pt; }
    .ped-name { font-weight: bold; }
    .ped-sub { font-size: 9pt; color: #555; }
    .exp-total { font-size: 14pt; font-weight: bold; }
    .exp-cat-title { font-weight: bold; padding: 4pt 0 2pt; border-top: 1pt solid #ccc; margin-top: 6pt; display: flex; justify-content: space-between; }
    .exp-cat-total { font-weight: bold; }
    .rpt-photo { float: right; margin: 0 0 12pt 16pt; width: 2in; height: 2in; object-fit: cover; border: 1pt solid #ccc; }
    .clearfix::after { content: ''; display: block; clear: both; }
    .profile-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 4pt; font-size: 10pt; }
    .profile-row { padding: 3pt 0; border-bottom: 0.5pt solid #f0f0f0; }
    .profile-label { color: #777; font-size: 9pt; }
    /* Hooves */
    .hf-lead { font-size: 9.5pt; color: #555; margin: 4pt 0 8pt; line-height: 1.45; }
    .hf-pairs { display: flex; flex-wrap: wrap; gap: 6pt; margin: 0 0 8pt; }
    .hf-tag { font-size: 9pt; font-weight: bold; padding: 2pt 8pt; border-radius: 10pt; border: 1pt solid #d1d5db; }
    .hf-tag.ok { color: #15803d; border-color: #86efac; } .hf-tag.check { color: #b45309; border-color: #fcd34d; }
    .hf-foot { break-inside: avoid; page-break-inside: avoid; border-top: 1pt solid #e5e7eb; padding: 8pt 0 6pt; }
    .hf-foot-name { font-size: 12pt; font-weight: bold; margin-bottom: 6pt; }
    .hf-views { display: grid; grid-template-columns: 1fr 1fr; gap: 12pt; }
    .hf-view img { display: block; max-width: 100%; max-height: 210pt; width: auto; height: auto; border-radius: 4pt; border: 0.5pt solid #e5e7eb; }
    .hf-nums { font-size: 9pt; color: #555; margin: 4pt 0 3pt; }
    .hf-nums b { font-size: 11pt; color: #111; }
    .hf-sum { list-style: none; margin: 0; padding: 0; font-size: 9pt; line-height: 1.4; }
    .hf-sum li { padding-left: 12pt; position: relative; margin-bottom: 2pt; }
    .hf-sum li::before { content: "•"; position: absolute; left: 0; color: #6b7280; font-weight: bold; }
    .hf-sum li.ok::before { content: "✓"; color: #15803d; }
    .hf-sum li.check::before { content: "!"; color: #b45309; }
    .hf-note { font-size: 9pt; color: #555; margin-top: 3pt; font-style: italic; }
    .hf-sub { font-size: 10pt; font-weight: bold; text-transform: uppercase; letter-spacing: .05em; color: #555; margin: 12pt 0 4pt; }
    .hf-guide { font-size: 8.5pt; color: #444; line-height: 1.4; padding-left: 14pt; margin: 0; }
    .hf-guide li { margin-bottom: 2pt; }
    .hf-thumb { width: 64pt; }
    .hf-thumb img { max-width: 60pt; max-height: 60pt; width: auto; height: auto; border-radius: 3pt; border: 0.5pt solid #e5e7eb; display: block; }
    .rpt-empty { margin: 30pt 0; padding: 18pt; border: 1pt dashed #ccc; border-radius: 6pt; text-align: center; color: #555; font-family: -apple-system, Helvetica, sans-serif; font-size: 12pt; line-height: 1.5; }
    .hf-fine { font-size: 8pt; color: #777; margin-top: 6pt; }
    @page { margin: 0.75in; }
    @media print {
      .no-print { display: none !important; }
      body { font-size: 10pt; }
      .print-page { padding: 0; max-width: 100%; }
      .rpt-section { page-break-inside: avoid; }
      .rpt-section.rpt-hooves { page-break-inside: auto; }
    }
  </style>
</head>
<body>
  <div class="no-print">
    <button class="btn-back" onclick="if (history.length > 1) { history.back() } else { window.location = document.querySelector('[data-back]')?.dataset.back || '/' }">‹ Back</button>
    <button class="btn-print" id="share-pdf" onclick="sharePdf(this)">Save / Share PDF</button>
    <button class="btn-close" onclick="window.print()">Print</button>
  </div>
  <script>
    // Builds a real PDF on the phone (no print dialog needed), then opens the share sheet:
    // Save to Files, Print, Mail, AirDrop. Computers without sharing get a download.
    function loadPdfLib() {
      if (window.html2pdf) return Promise.resolve()
      return new Promise((resolve, reject) => {
        const s = document.createElement("script")
        s.src = "/vendor/html2pdf.bundle.min.js"
        s.onload = resolve
        s.onerror = () => reject(new Error("Couldn't load the PDF maker."))
        document.head.appendChild(s)
      })
    }
    // Every photo loaded and decoded first, or it can come out missing.
    function imagesReady(root) {
      return Promise.all([...root.querySelectorAll("img")].map((img) =>
        (img.complete ? Promise.resolve() : new Promise((r) => { img.onload = img.onerror = r }))
          .then(() => img.decode ? img.decode().catch(() => {}) : null)))
    }

    // The report split into pieces (whole sections) of at most `maxArea` square pixels.
    function chunksOf(page, maxArea) {
      const width = page.scrollWidth
      if (width * page.scrollHeight <= maxArea) return [page]
      const groups = []
      let group = null, height = 0
      for (const el of page.children) {
        const h = el.getBoundingClientRect().height
        if (!group || (height + h) * width > maxArea) {
          group = document.createElement("div")
          group.className = "print-page pdf-chunk"
          groups.push(group)
          height = 0
        }
        group.appendChild(el.cloneNode(true))
        height += h
      }
      return groups
    }

    async function sharePdf(btn) {
      const label = btn.textContent
      btn.disabled = true
      btn.textContent = "Making PDF…"
      try {
        await loadPdfLib()
        // Capture from the top, whatever part of the report is on screen.
        window.scrollTo(0, 0)
        const page = document.querySelector(".print-page")
        await imagesReady(page)
        const name = (document.title.replace(/^Report — /, "") || "Report") + " report.pdf"
        const opt = {
          margin: [0.5, 0.5, 0.6, 0.5],
          filename: name,
          image: { type: "jpeg", quality: 0.92 },
          html2canvas: { scale: 2, useCORS: true, backgroundColor: "#ffffff", scrollX: 0, scrollY: 0 },
          jsPDF: { unit: "in", format: "letter", orientation: "portrait" },
          pagebreak: { mode: ["css", "legacy"], avoid: ["tr", ".rpt-photo", ".rpt-chart", ".ped-grid", ".hf-foot"] }
        }
        // iPads and iPhones draw nothing at all past about 16 million pixels, which
        // comes out as a blank PDF. A long report is drawn in pieces that each fit.
        const chunks = chunksOf(page, 12e6 / (opt.html2canvas.scale ** 2))
        let worker = html2pdf().set(opt).from(chunks[0]).toPdf()
        for (const chunk of chunks.slice(1)) {
          worker = worker.get("pdf").then((pdf) => pdf.addPage()).from(chunk).toContainer().toCanvas().toPdf()
        }
        const blob = await worker.outputPdf("blob")
        const file = new File([blob], name, { type: "application/pdf" })
        if (navigator.canShare && navigator.canShare({ files: [file] })) {
          try { await navigator.share({ files: [file], title: name }) } catch (_) {}
        } else {
          const url = URL.createObjectURL(blob)
          const a = document.createElement("a")
          a.href = url; a.download = name
          document.body.appendChild(a); a.click(); a.remove()
          setTimeout(() => URL.revokeObjectURL(url), 60000)
        }
      } catch (e) {
        alert("Couldn't make the PDF: " + e.message)
      } finally {
        btn.disabled = false
        btn.textContent = label
      }
    }
  </script>
  <%= @inner_content %>
  <script>
    // Nothing matched what was picked: say so instead of a blank page.
    (() => {
      const page = document.querySelector(".print-page")
      if (!page || page.querySelector(".rpt-section")) return
      const msg = document.createElement("div")
      msg.className = "rpt-empty"
      msg.id = "rpt-empty"
      msg.innerHTML = "<b>Nothing to show for what you picked.</b><br>The sections you checked have no entries" +
        (location.search.includes("from=") || location.search.includes("to=") ? " in that date range" : "") +
        ".<br>Go back and pick more sections, or tap Select all."
      const header = page.querySelector(".rpt-header")
      header ? header.after(msg) : page.prepend(msg)
      const pdf = document.getElementById("share-pdf")
      if (pdf) pdf.disabled = true
    })()
  </script>
</body>
</html>
